<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AEGIS - Dashboard Kemanan Kapal</title>
    
    <!-- Memanggil alat bantu untuk desain (Tailwind) dan Peta (Leaflet) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    
    <!-- Gaya tambahan untuk efek peta dan titik berkedip -->
    <style>
        #map { height: 300px; width: 100%; border-radius: 0.5rem; z-index: 1; }
        .ping-dot { animation: ping 1.5s cubic-bezier(0, 0, 0.2, 1) infinite; }
        @keyframes ping {
            75%, 100% { transform: scale(2); opacity: 0; }
        }
    </style>
</head>
<body class="bg-gray-100 font-sans p-4">

    <div class="max-w-4xl mx-auto space-y-6">
        
        <!-- BAGIAN ATAS: LOGO DAN JUDUL -->
        <div class="bg-white rounded-2xl shadow-sm p-6 flex items-center justify-between">
            <div class="flex items-center space-x-4">
                <!-- Gambar Logo Perisai (AEGIS) -->
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" class="w-14 h-14">
                    <defs>
                        <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" style="stop-color:#0284c7;stop-opacity:1" />
                            <stop offset="100%" style="stop-color:#06b6d4;stop-opacity:1" />
                        </linearGradient>
                    </defs>
                    <path d="M50 5 L10 20 L10 50 C10 75 30 90 50 95 C70 90 90 75 90 50 L90 20 Z" fill="url(#grad1)" />
                    <path d="M25 60 Q 37.5 45, 50 60 T 75 60 L75 80 C60 88 40 88 25 80 Z" fill="#ffffff" opacity="0.4" />
                    <circle cx="50" cy="40" r="10" fill="#ffffff" />
                </svg>
                <div>
                    <h1 class="text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-sky-600 to-cyan-500 tracking-wider">AEGIS</h1>
                    <p class="text-gray-500 text-sm font-medium tracking-widest">SISTEM PANTAU LAMBUNG KAPAL</p>
                </div>
            </div>
            <div class="text-right hidden sm:block">
                <span class="text-xs text-gray-400 block">Status Jaringan</span>
                <span class="inline-flex items-center bg-green-100 text-green-800 text-xs font-bold px-2 py-1 rounded-full">
                    <span class="w-2 h-2 mr-1 bg-green-500 rounded-full"></span> Terhubung
                </span>
            </div>
        </div>

        <!-- BAGIAN TENGAH: KOTAK INFORMASI -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            
            <!-- KOTAK 1: METERAN AIR -->
            <div class="bg-white rounded-2xl shadow-sm p-6 flex flex-col items-center">
                <h2 class="text-gray-600 font-semibold mb-4 w-full text-left">Level Genangan Air</h2>
                
                <!-- Kanvas untuk menggambar meteran setengah lingkaran -->
                <div class="relative w-full max-w-[250px] aspect-square flex items-center justify-center">
                    <canvas id="gaugeChart"></canvas>
                    <!-- Angka di tengah meteran -->
                    <div class="absolute inset-0 flex flex-col items-center justify-center pt-10">
                        <span id="waterValue" class="text-4xl font-bold text-green-500 transition-colors duration-300">0</span>
                        <span class="text-gray-400 text-sm">/ 4095</span>
                    </div>
                </div>

                <!-- Status Teks di bawah meteran -->
                <div class="w-full mt-6 border-t pt-4">
                    <p class="text-gray-500 text-sm mb-1">Status Kapal</p>
                    <div class="flex items-center space-x-3">
                        <div class="relative flex h-4 w-4">
                            <!-- Titik warna yang bisa menyala/berkedip -->
                            <span id="statusPing" class="ping-dot absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                            <span id="statusDot" class="relative inline-flex rounded-full h-4 w-4 bg-green-500"></span>
                        </div>
                        <h3 id="statusText" class="text-xl font-bold text-gray-800 transition-colors duration-300">SAFE - Kering</h3>
                    </div>
                </div>
            </div>

            <!-- KOTAK 2: PETA LOKASI -->
            <div class="bg-white rounded-2xl shadow-sm p-6 flex flex-col">
                <h2 class="text-gray-600 font-semibold mb-4">Lokasi Koordinat</h2>
                <div id="map" class="shadow-inner border border-gray-200"></div>
                <div class="mt-4 flex flex-col sm:flex-row sm:justify-between text-sm text-gray-600 bg-gray-50 p-3 rounded-lg border">
                    <div><span class="font-semibold text-gray-400">Lat:</span> -7.309892</div>
                    <div><span class="font-semibold text-gray-400">Long:</span> 112.760017</div>
                </div>
            </div>

        </div>
    </div>

    <!-- Memanggil alat bantu pembuat grafik (Chart.js) dan Peta (Leaflet) -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        // ---------------------------------------------------------
        // 1. PENGATURAN PETA (LEAFLET)
        // ---------------------------------------------------------
        // Mengatur titik koordinat peta (Bisa diganti dengan data GPS dari alatmu)
        const lat = -7.309892;
        const lng = 112.760017;
        
        const map = L.map('map').setView([lat, lng], 15);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap contributors'
        }).addTo(map);

        const marker = L.marker([lat, lng]).addTo(map)
            .bindPopup('<b>Lokasi Kapal</b><br>Sistem AEGIS')
            .openPopup();

        // ---------------------------------------------------------
        // 2. PENGATURAN GRAFIK METERAN (CHART.JS)
        // ---------------------------------------------------------
        const ctx = document.getElementById('gaugeChart').getContext('2d');
        const gaugeChart = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['Terisi', 'Kosong'],
                datasets: [{
                    data: [0, 4095], // Nilai awal
                    backgroundColor: ['#22c55e', '#e5e7eb'], // Hijau dan Abu-abu
                    borderWidth: 0,
                    circumference: 180, // Setengah lingkaran
                    rotation: 270 // Mulai dari sisi kiri
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '80%', // Ketebalan garis
                plugins: { legend: { display: false }, tooltip: { enabled: false } },
                animation: { animateRotate: true, animateScale: false }
            }
        });

        // ---------------------------------------------------------
        // 3. FUNGSI UNTUK MENGUBAH TAMPILAN SESUAI DATA
        // ---------------------------------------------------------
        function updateDashboard(value) {
            const maxValue = 4095;
            const waterValueText = document.getElementById('waterValue');
            const statusText = document.getElementById('statusText');
            const statusPing = document.getElementById('statusPing');
            const statusDot = document.getElementById('statusDot');

            // Hitung sisa ruang kosong di grafik
            let remaining = maxValue - value;
            if (remaining < 0) remaining = 0;

            // Perbarui data di grafik meteran
            gaugeChart.data.datasets[0].data = [value, remaining];
            waterValueText.innerText = value;

            // Aturan penentuan status (Bisa kamu sesuaikan batasannya)
            if (value < 1000) {
                // KONDISI AMAN (HIJAU)
                gaugeChart.data.datasets[0].backgroundColor[0] = '#22c55e'; // Hijau
                waterValueText.className = 'text-4xl font-bold transition-colors duration-300 text-green-500';
                statusText.innerText = 'SAFE - Kering';
                statusText.className = 'text-xl font-bold transition-colors duration-300 text-green-600';
                statusPing.className = 'ping-dot absolute inline-flex h-full w-full rounded-full opacity-75 bg-green-400';
                statusDot.className = 'relative inline-flex rounded-full h-4 w-4 bg-green-500';
            
            } else if (value < 2000) {
                // KONDISI PERINGATAN (KUNING/ORANYE)
                gaugeChart.data.datasets[0].backgroundColor[0] = '#f59e0b'; // Oranye
                waterValueText.className = 'text-4xl font-bold transition-colors duration-300 text-amber-500';
                statusText.innerText = 'ALERT - Rembesan Air';
                statusText.className = 'text-xl font-bold transition-colors duration-300 text-amber-600';
                statusPing.className = 'ping-dot absolute inline-flex h-full w-full rounded-full opacity-75 bg-amber-400';
                statusDot.className = 'relative inline-flex rounded-full h-4 w-4 bg-amber-500';
            
            } else {
                // KONDISI BAHAYA (MERAH)
                gaugeChart.data.datasets[0].backgroundColor[0] = '#ef4444'; // Merah
                waterValueText.className = 'text-4xl font-bold transition-colors duration-300 text-red-500';
                statusText.innerText = 'EMERGENCY - KEBOCORAN!';
                statusText.className = 'text-xl font-bold transition-colors duration-300 text-red-600';
                statusPing.className = 'ping-dot absolute inline-flex h-full w-full rounded-full opacity-75 bg-red-400';
                statusDot.className = 'relative inline-flex rounded-full h-4 w-4 bg-red-500';
            }

            gaugeChart.update();
        }

        // ---------------------------------------------------------
        // 4. SIMULASI DATA SEMENTARA (HAPUS INI JIKA SUDAH PAKAI ALAT ASLI)
        // ---------------------------------------------------------
        // Ini hanya untuk melihat contoh animasi bergerak.
        // Jika nanti digabungkan dengan ESP32, bagian ini diganti dengan kode fetch API.
        setInterval(() => {
            const randomLevels = [250, 1691, 3200];
            const randomValue = randomLevels[Math.floor(Math.random() * randomLevels.length)];
            updateDashboard(randomValue);
        }, 4000); // Berganti otomatis setiap 4 detik

    </script>
</body>
</html>
